{
  "name": "@sudoku/solver-core",
  "version": "0.1.0",
  "description": "Zero-dependency TypeScript port of the four Sudoku solvers (parity-checked against the Python reference).",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./worker": {
      "types": "./dist/worker/index.d.ts",
      "default": "./dist/worker/index.js"
    },
    "./worker-entry": {
      "types": "./dist/worker/solverWorker.d.ts",
      "default": "./dist/worker/solverWorker.js"
    }
  },
  "files": ["dist", "src"],
  "sideEffects": ["./dist/worker/solverWorker.js", "./src/worker/solverWorker.ts"],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "bench": "node bench/bench.ts"
  },
  "devDependencies": {
    "typescript": "^5.6.3",
    "vitest": "^2.1.8"
  }
}
